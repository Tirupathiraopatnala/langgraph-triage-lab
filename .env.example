# Copy this file to .env and fill it in. .env is git-ignored. Never commit it.

# ---- Fabric -----------------------------------------------------------------
# "fake" runs against a pretend workspace built into the code (no Azure needed).
# "real" talks to your Fabric workspace through the REST API.
FABRIC_MODE=fake

# Comma-separated workspace GUIDs to scan (real mode).
FABRIC_WORKSPACE_IDS=

# Service principal. Leave all three empty to use DefaultAzureCredential instead
# (your `az login` on a laptop, managed identity in Azure).
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# How far back to look for failed runs.
FABRIC_LOOKBACK_HOURS=24

# Writes are off unless you turn them on AND list the workspace here. Use a dev workspace.
FABRIC_WRITES_ENABLED=false
FABRIC_WRITE_WORKSPACE_IDS=

# ---- Model ------------------------------------------------------------------
# "fake" uses a scripted stand-in model (free, offline, deterministic).
# "azure" calls your Azure OpenAI deployment in Foundry.
MODEL_MODE=fake

# Resource endpoint, e.g. https://<resource>.openai.azure.com or
# https://<resource>.services.ai.azure.com. The code adds /openai/v1 itself.
AZURE_OPENAI_ENDPOINT=
# Deployment name (not the model name).
AZURE_OPENAI_DEPLOYMENT=
# Leave empty to use Entra ID (DefaultAzureCredential) instead of a key.
AZURE_OPENAI_API_KEY=
# Token scope for Entra auth. Use https://ai.azure.com/.default for a services.ai.azure.com endpoint.
AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
# true = Responses API, false = Chat Completions. Some newer models need Responses.
AZURE_OPENAI_USE_RESPONSES=true

# ---- Agent ------------------------------------------------------------------
TRIAGE_DB_PATH=data/triage.sqlite
SUPERVISOR_MAX_HOPS=4
SPECIALIST_MAX_TOOL_CALLS=8
